# 生产环境变量示例（复制为 .env.prod）

# 你的生产域名（不要带 https://）
SITE_DOMAIN=example.com

# ACME 证书通知邮箱（Caddy 自动签发/续期 HTTPS）
ACME_EMAIL=admin@example.com

# 后端 JWT 密钥（必须替换为足够随机的长字符串）
JWT_SECRET=change-this-to-a-long-random-secret

# 后端运行模式
SERVER_MODE=release

# 数据与内容目录（容器内路径，通常保持默认）
DATABASE_PATH=/app/data/mdxy.db
CONTENT_NOTES_DIR=/app/content/notes
CONTENT_ARTICLES_DIR=/app/content/articles
